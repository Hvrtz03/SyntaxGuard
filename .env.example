# Copia este archivo a ".env" y ajusta los valores si lo necesitas.
# NUNCA subas el archivo ".env" a Git (solo este ".env.example").
# Desde la Fase 6A hay usuarios y sesiones: define SG_SECRET_KEY (ver más abajo).

# Dirección donde escucha la API. 127.0.0.1 = solo tu computadora.
SG_HOST=127.0.0.1

# Puerto de la API y de la interfaz web.
SG_PUERTO=8000

# 1 = abrir el navegador automáticamente al iniciar; 0 = no abrirlo.
SG_ABRIR_NAVEGADOR=1

# ---------- Fase 6A: usuarios y sesiones ----------
# Clave del servidor (mínimo 32 caracteres). Genera una con:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si no la defines, se usa una clave aleatoria en memoria y las sesiones se pierden al reiniciar el servidor.
# Con SG_ENTORNO=produccion es OBLIGATORIA y la cookie de sesión se marca Secure.
SG_SECRET_KEY=
SG_ENTORNO=desarrollo

# Opcionales (valores por defecto entre paréntesis). Contrato completo: frontend/documentacion/FASE6_CONTRATO_API.md
# SG_SESION_MAX_HORAS=168            (expiración absoluta de la sesión)
# SG_SESION_INACTIVIDAD_HORAS=24     (expiración por inactividad)
# SG_LOGIN_MAX_INTENTOS=5            (fallos por usuario+IP antes del bloqueo de 15 minutos)
# SG_REGISTRO_MAX_POR_HORA=10        (registros por IP y hora)
# SG_COOKIE_SAMESITE=strict          (strict o lax)
# SG_COOKIE_SECURE=0                 (1 = cookie Secure aunque se use http)
# SG_ORIGENES_PERMITIDOS=            (orígenes extra permitidos, separados por comas)
# SG_CONFIAR_PROXY=0                 (1 solo detrás de un proxy propio)
